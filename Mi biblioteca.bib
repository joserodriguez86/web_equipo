  author = {Zhao, Huali and Qiao, Jinhui and Shen, Xinyue and Dong, Yue and Hu, Yue and Zhang, Yingying and Yang, Fei and You, Jin},
  date = {2025-06-01},
  journaltitle = {Research in Social Stratification and Mobility},
