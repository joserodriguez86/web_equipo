@article{Dalle.Stiberman2017,
  title = {Clases populares en Argentina: cambios recientes en su composición ocupacional (1998-2015)},
  shorttitle = {Clases populares en Argentina},
  author = {Dalle, Pablo and Stiberman, Laura},
  date = {2017-12-28},
  journaltitle = {Encrucijadas - Revista Crítica de Ciencias Sociales},
  volume = {14},
  number = {0},
  pages = {1405},
  issn = {2174-6753},
  url = {http://www.encrucijadas.org/index.php/ojs/article/view/300},
  urldate = {2018-09-04},
  abstract = {La desindustrialización que acompañó la apertura económica y la desarticulación del Estado de Bienestar durante la dictadura y con mayor profundidad en la década de 1990, tuvieron efectos regresivos sobre la estructura social. Una de las consecuencias más importantes fue la desestructuración y reducción de la clase obrera industrial, que había sido durante el período de industrialización por sustitución de importaciones el núcleo más dinámico de las clases populares. En la última década, en el marco de un elevado crecimiento económico apoyado en la exportación de commodities y sobre todo en la expansión del mercado interno, el giro en el modelo de desarrollo se ha orientado a favorecer al sector productivo. Si bien hay consenso sobre los efectos favorables de estos procesos en las tendencias de empleo, existen divergencias acerca de su impacto en la estructura de clases.En este trabajo nos proponemos analizar la evolución del volumen y composición de las clases populares, en particular de la clase obrera, entre 1998 y 2013. Específicamente, analizaremos qué tipo de reconfiguraciones se produjeron en las clases populares a partir de identificar fracciones según el tipo de ocupación, la calificación y la condición de registro en la seguridad social.},
  langid = {spanish},
  keywords = {acceso a  seguridad social.,access to social security.,asalarización,calificación,capitulo 3.3,clase obrera,clases populares,popular classes,qualification,salaryzation,working class},
  file = {C\:\\Users\\josed\\Zotero\\storage\\MTEQL49L\\Dalle y Stiberman - 2017 - Clases populares en Argentina cambios recientes e.pdf;C\:\\Users\\josed\\Zotero\\storage\\DC9FEYNN\\300.html}
}

