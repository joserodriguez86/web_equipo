@article{Jackson1962,
  title = {Status {{Consistency}} and {{Symptoms}} of {{Stress}}},
  author = {Jackson, Elton},
  date = {1962-08-01},
  journaltitle = {American Sociological Review},
  volume = {27},
  pages = {469},
  doi = {10.2307/2090028},
  abstract = {The stressful impact of status inconsistency on the individual is examined with national survey data, using expressed psychophysiological symptoms as the indicator of psychological disturbance. Inconsistency due to racial-ethnic rank superior to occupational or educational rank is associated with high symptom levels; although the opposite patterns of inconsistency are not, they have been shown in previous research to be associated with political liberalism. These findings are interpreted to mean that all forms of status inconsistency are psychologically disturbing, but that response to this stress varies with the relative positions of the inconsistent person's achieved and ascribed status ranks and with his achieved status per se. Also, sex appears to influence response to occupation--education inconsistencies. These findings provide support for a multi-dimensional view of social stratification.}
}

