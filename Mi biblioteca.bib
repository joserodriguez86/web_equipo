@inproceedings{ActisDiPasquale2015,
  title = {Hacia una definición conceptual de bienestar social. El debate desde la economía del bienestar hasta enfoque de las capacidades},
  booktitle = {VI Encuentro Regional de Estudios del Trabajo, Tandil [ARG], 7-8 septiembre 2015. ISBN 978-950-658-376-7.},
