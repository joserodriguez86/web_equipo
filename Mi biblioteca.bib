  shorttitle = {The “{{Eye}} of the {{Hurricane}}” {{Paradox}}},
  author = {Recchi, Ettore and Ferragina, Emanuele and Helmeid, Emily and Pauly, Stefan and Safi, Mirna and Sauger, Nicolas and Schradie, Jen},
