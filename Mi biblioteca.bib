  number = {33},
  pages = {55--89},
  issn = {0719-6458},
  doi = {10.29344/07196458.33.3629},
  url = {https://ediciones.ucsh.cl/index.php/TSUCSH/article/view/3629},
  urldate = {2024-01-17},
  abstract = {The relative deprivation approach to poverty measurement has little more than four decades of sustained theoretical-methodological developments. However, these advances are hardly known in Latin America. Much less clear are the potential advantages of the relative deprivation perspective over the more popular traditions of poverty measurement such as the unmet basic needs approach or the income poverty measurement. Based on measurement theory, this article analyzes three fundamental differences between the forms regularly used to measure poverty in Latin America and the relative poverty model: theoretical coverage, consistency and generation of data, and the treatment of the multidimensional nature of poverty. It is concluded from a scientific point of view, that the relative deprivation approach is better positioned to measure poverty, that adopting the measurement theory provides greater freedom to the researcher to substitute indicators without losing comparability, while at the same time demanding that rigorous statistical criteria are met and generating measurements consistent with the prevailing living standards in the region during the twenty-first century.},
  issue = {33},
  langid = {spanish},
  keywords = {medición de pobreza,pobreza},
  file = {C:\Users\josed\Zotero\storage\ASGYZAU4\Cortés y Nájera - 2023 - Medición de pobreza en América Latina un estudio .pdf}
