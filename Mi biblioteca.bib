  abstract = {{$<$}p{$>$}Research on perceptions of economic inequality focuses on estimations of the distribution of financial resources, such as perceived income gaps or wealth distribution. However, we argue that perceiving inequality is not limited to an economic idea but also includes other dimensions related to people’s daily life. We explored this idea by conducting an online survey ({$<$}italic{$>$}N{$<$}/italic{$>$} = 601) in Colombia, where participants responded to an open-ended question regarding how they perceived economic inequality. We performed a content analysis of 1,624 responses to identify relevant topics and used network analysis tools to explore how such topics were interrelated. We found that perceived economic inequality is mainly represented by identifying social classes (e.g., the elites vs. the poor), intergroup relations based on discrimination and social exclusion, public spaces (e.g., beggars on streets, spatial segregation), and some dynamics about the distribution of economic resources and the quality of work (e.g., income inequality, precarious jobs). We discuss how different perceptions of economic inequality may frame how people understand and respond to inequality.{$<$}/p{$>$}},
  langid = {english},
  keywords = {Colombia,Content Analysis,Economic inequality,framing,Network analisys,perceptions},
  file = {C:\Users\josed\Zotero\storage\HXZS5I3Z\García-Sánchez et al. - 2018 - Perceptions of Economic Inequality in Colombian Daily Life More Than Unequal Distribution of Econom.pdf}
}

