@article{Girod.Fricker1971,
  title = {Mobilité Séquentielle},
  author = {Girod, Roger and Fricker, Yves},
  date = {1971},
  journaltitle = {Revue française de sociologie},
  volume = {12},
  number = {1},
  eprint = {3320396},
  eprinttype = {jstor},
  pages = {3--18},
  publisher = {[Sciences Po University Press, Association Revue Française de Sociologie]},
  issn = {0035-2969},
  doi = {10.2307/3320396},
  url = {https://www.jstor.org/stable/3320396},
  urldate = {2023-09-28},
  abstract = {The question is when are most intergenerational mobility movements taking place? At first regular job step (that is as a direct product of adolescent socialization) or later? That question pertains to what may be called sequential analysis of mobility, a perspective dividing life cycle into several steps. On that basis, it is clear, for instance, that part of intragenerational mobility (moves after first job) increases intergenerational mobility, but that other career moves are diminishing the social distance between generations. Example: father non-manual, son's first job manual, son's job later non-manual. In such a case, job mobility is not a sign of social mobility. On the contrary the inherited status is probably strengthened by it. This kind of cases may be labelled " contra-mobility ". According to a Geneva survey dealing in particular with men aged 50 years and more, the majority of career moves are to be considered as contra-mobility. This survey is presented in the paper. It shows also that the share of first job mobility (difference between father's job and first job) in intergenerational mobility is by far greater than the contribution of further sequences. Comparisons between cohorts indicate that first job mobility is probably increasing as a function of modernization. /// Según una información que se realizó en Ginebra y que concernía a los hombres de más de 50 años de edad, resulta que la mayoría de los cambios de nivel social entre cada generación se producen al fin del período de formación, al emprender un oficio. Producen sobre todo las secansas siguientes del ciclo de vida movimientos de " contramovilidad ". Son ellos cambios de empleo que vuelven a colocar a una persona en su categoría de origen en vez de alejarla de ella. Por ejemplo, el hijo de un comerciante que fué clasificado obrero durante cierto tiempo al principio se ha vuelto después comerciante o cuadro medio. Parece que en Francia y en los Estados Unidos es muy importante también la " contramovilidad ". Incita pues la perspectiva secuencial a plantear ciertos problemas de movilidad con términos nuevos. /// Eine in Genf durchgeführte Erhebung, die sich hauptsächlich mit über 50 Jahre alten Menschen beschäftigte, hat ergeben, dass die meisten Intra-Generations-Umwandlungen des Sozialniveaus am Ende des Entwicklungstadiums stattfinden, und zwar beim Eintritt in die Welt der Arbeit. Die folgenden Sequenzen des Lebenszyklus bringen vor allem Gegenmobilitätsbewegungen mit sich. Es handelt sich hierbei um Arbeitsplatzwechsel, die den Betroffenen zu seiner ursprünglichen Kategorie zurückführen, anstatt ihn davon zu entfernen. Ein Beispiel: ein Händlersohn, am Anfang eine Zeitland als Arbeiter eingestuft, anschliessend Händler oder mittler Angestellter geworden. Anscheinend ist auch in Frankreich und in den USA die Gegenmobilität bedeutend. Die sequenzielle Perspektive führt somit dazu, gewisse Probleme der Mobilität neu zu formulieren. /// Из анкеты выполменной в Женеве и относящейся главным образом к мужчинам 50-ти летенего возраста оказывается, что перемены между поколениями определенного социального уревня происходят в конце перида подготовки и воспитания, а именно в момент начала их трудодеятельности. Последовательность согласно циклу жизни приводит главным образом к движению "контр-изменьчивости". Этим движением является перемена службы которая приближает инднвидуума к категории его пронсхождения, вместо того чтобы его отдалить от нея. Прнмер: сын коммерсанта засчитанный в качестве рабочего на некоторое время в начале своей трудодеятельности становится в послеедствии коммерсантом или средне штатским служащим. Повидимому как во Франции так и в СІІІА "контр-изменьчивость" довольно значнтельна. Перспектива в последовательности таким образом заставляет поставить некоторые проблемы изменьчивости в новом свете.},
  file = {C:\Users\josed\Zotero\storage\578N8N54\Girod y Fricker - 1971 - Mobilité séquentielle.pdf}
}

