@article{Rooduijn.Burgoon2018,
  title = {The {{Paradox}} of {{Well-being}}: {{Do Unfavorable Socioeconomic}} and {{Sociocultural Contexts Deepen}} or {{Dampen Radical Left}} and {{Right Voting Among}} the {{Less Well-Off}}?},
  shorttitle = {The {{Paradox}} of {{Well-being}}},
  author = {Rooduijn, Matthijs and Burgoon, Brian},
