@article{Cortes1997,
  title = {Determinantes de La Pobreza de Los Hogares. {{México}}, 1992},
  author = {Cortés, Fernando},
  date = {1997},
  journaltitle = {Revista Mexicana de Sociología},
  volume = {59},
  number = {2},
  eprint = {3541165},
