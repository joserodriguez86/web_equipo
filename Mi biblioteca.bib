@article{Castaneda.etal2020,
  title = {Opting {{Out}} of the {{Social Contract}}: {{Tax Morale}} and {{Evasion}}},
  shorttitle = {Opting {{Out}} of the {{Social Contract}}},
  author = {Castañeda, Néstor and Doyle, David and Schwartz, Cassilde},
  date = {2020-06},
  journaltitle = {Comparative Political Studies},
