@article{Sacco.Borges2018,
  title = {¿{{Converge}} La Fecundidad En {{Brasil}} y {{Argentina}}? {{Un}} Enfoque Desde Las Desigualdades},
  shorttitle = {¿{{Converge}} La Fecundidad En {{Brasil}} y {{Argentina}}?},
  author = {Sacco, Nicolás and Borges, Gabriel},
  date = {2018},
  journaltitle = {Revista Brasileira de Estudos de População},
  volume = {35},
  number = {1},
  pages = {1--29},
  issn = {1980-5519},
  doi = {10.20947/S0102-3098a0039},
  url = {https://rebep.emnuvens.com.br/revista/article/view/1180},
  urldate = {2020-11-17},
  abstract = {Resumo 					A ideia de uma tendência da fecundidade na direção de níveis convergentes na América Latina e Caribe tem uma ampla aceitação, tanto em estudos acadêmicos quanto nos pressupostos das projeções de população dos países da região. Contudo, pouco se sabe sobre os processos de convergência demográfica ao se decompor a fecundidade segundo variáveis de diferenciação social. O objetivo deste artigo foi observar de forma comparada a hipótese de convergência demográfica na Argentina e no Brasil de 1970 a 2010 de acordo com uma análise de período das taxas de fecundidade total segundo regiões estatísticas, níveis educativos e categorias sócio- ocupacionais. Os dados provêm dos censos nacionais de população e as variáveis foram harmonizadas de forma a permitir comparação entre ambos os países. Utilizou-se uma modificação da técnica P/F de Brass e do modelo relacional de Gompertz para estimar os níveis de fecundidade, e medidas de convergência e dispersão para avaliar as variáveis de análise.~Os resultados mostram evidência de convergência durante o período de estudo, especialmente para o Brasil, ainda que com alguns ciclos de divergência e diferenças notórias entre os dois países, em particular daqueles derivados da posição na estrutura ocupacional.},
  issue = {1},
  langid = {english},
  keywords = {Argentina,Brasil,Convergência demográfica,Estrutura social,Fecundidade},
  file = {C\:\\Users\\josed\\Zotero\\storage\\V3CQUDUD\\Sacco y Borges - 2018 - ¿Converge la fecundidad en Brasil y Argentina Un .pdf;C\:\\Users\\josed\\Zotero\\storage\\CBQHXDCD\\1180.html}
}

