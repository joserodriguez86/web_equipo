@article{Mari-DellOlmo.etal2021,
  title = {Socioeconomic {{Inequalities}} in {{COVID-19}} in a {{European Urban Area}}: {{Two Waves}}, {{Two Patterns}}},
  shorttitle = {Socioeconomic {{Inequalities}} in {{COVID-19}} in a {{European Urban Area}}},
  author = {Marí-Dell’Olmo, Marc and Gotsens, Mercè and Pasarín, M. Isabel and Rodríguez-Sanz, Maica and Artazcoz, Lucía and Garcia de Olalla, Patricia and Rius, Cristina and Borrell, Carme},
  date = {2021-01},
  journaltitle = {International Journal of Environmental Research and Public Health},
  volume = {18},
  number = {3},
  pages = {1256},
  publisher = {Multidisciplinary Digital Publishing Institute},
  doi = {10.3390/ijerph18031256},
  url = {https://www.mdpi.com/1660-4601/18/3/1256},
  urldate = {2021-05-07},
  abstract = {Background: The objective of this paper is to analyze social inequalities in COVID-19 incidence, stratified by age, sex, geographical area, and income in Barcelona during the first two waves of the pandemic. Methods: We collected data on COVID-19 cases confirmed by laboratory tests during the first two waves of the pandemic (1 March to 15 July and 16 July to 30 November, 2020) in Barcelona. For each wave and sex, we calculated smooth cumulative incidence by census tract using a hierarchical Bayesian model. We analyzed income inequalities in the incidence of COVID-19, categorizing the census tracts into quintiles based on the income indicator. Results: During the two waves, women showed higher COVID-19 cumulative incidence under 64 years, while the trend was reversed after that threshold. The incidence of the disease was higher in some poor neighborhoods. The risk ratio (RR) increased in the poorest groups compared to the richest ones, mainly in the second wave, with RR being 1.67 (95\% Credible Interval-CI-: 1.41\&ndash;1.96) in the fifth quintile income group for men and 1.71 (95\% CI: 1.44\&ndash;1.99) for women. Conclusion: Our results indicate the existence of inequalities in the incidence of COVID-19 in an urban area of Southern Europe.},
  issue = {3},
  langid = {english},
  keywords = {COVID-19,geographical area,inequalities,urban area},
  file = {C:\Users\josed\Zotero\storage\63TG85AA\Marí-Dell’Olmo et al. - 2021 - Socioeconomic Inequalities in COVID-19 in a Europe.pdf}
}

