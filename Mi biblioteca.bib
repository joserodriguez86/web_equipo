@book{Salvia.etal2018,
  title = {El escenario laboral de la economía popular: tipos de inserción ocupacional y características de los trabajadores},
  shorttitle = {El escenario laboral de la economía popular},
  author = {Salvia, Agustín and Poy Piñeiro, Santiago and Donza, Eduardo Ricardo},
