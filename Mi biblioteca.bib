@article{Bukodi.etal2016,
  title = {Is {{Education Now Class Destiny}}? {{Class Histories}} across {{Three British Birth Cohorts}}},
  shorttitle = {Is {{Education Now Class Destiny}}?},
  author = {Bukodi, Erzsébet and Goldthorpe, John H. and Halpin, Brendan and Waller, Lorraine},
  date = {2016},
