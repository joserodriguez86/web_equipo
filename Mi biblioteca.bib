@article{Barone.etal2022,
  title = {The Rise of Income and the Demise of Class and Social Status? {{A}} Systematic Review of Measures of Socio-Economic Position in Stratification Research},
  shorttitle = {The Rise of Income and the Demise of Class and Social Status?},
  author = {Barone, Carlo and Hertel, Florian R. and Smallenbroek, Oscar},
  date = {2022-04-01},
  journaltitle = {Research in Social Stratification and Mobility},
  shortjournal = {Research in Social Stratification and Mobility},
  volume = {78},
  pages = {100678},
  issn = {0276-5624},
  doi = {10.1016/j.rssm.2022.100678},
  url = {https://www.sciencedirect.com/science/article/pii/S0276562422000051},
  urldate = {2023-10-13},
  abstract = {How empirical researchers measure socio-economic position is of great consequence for the understanding of different aspects of the stratification order and affects our conclusions about the causes and consequences of social inequalities. This article surveys social stratification research published in 2015–2019 in top-cited sociology journals to quantify the prevalence of the three approaches towards social position: income, class and social status. To study trends in researchers' measurement decisions over time, we compare with articles published in the same journals in 1995–1999. In both periods, income measures dominate stratification research and are gaining ground on class and social status measures over time. However the dominance of income differs between research areas. Intergenerational research on education and social mobility may be the last bastion of occupation-based measures. We also find that EGP-like schemes are largely prevalent within class analysis and have gained a paradigmatic status of a "one-size-fits-all" measure. We argue that these trends have profound implications for stratification research in sociology that may herald the death of class-analysis.},
  keywords = {Income,Measurement,Position,Social class,Socioeconomic,Stratification research,Systematic review,Trend},
  file = {C\:\\Users\\josed\\Zotero\\storage\\XH6VATTE\\Barone et al. - 2022 - The rise of income and the demise of class and soc.pdf;C\:\\Users\\josed\\Zotero\\storage\\Z6W3V7JK\\S0276562422000051.html}
}

