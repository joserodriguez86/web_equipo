}

@article{Dvoskin.Bevegni2020,
  title = {El postpostneoliberalismo sudamericano: una mirada desde el análisis de las políticas sociales},
  shorttitle = {El postpostneoliberalismo sudamericano},
  author = {Dvoskin, Nicolás and Bevegni, Mayra},
  date = {2020-11-24},
  journaltitle = {Realidad Económica},
  number = {335},
  publisher = {Instituto Argentino para el Desarrollo Económico},
  issn = {0325-1926},
  url = {https://ri.conicet.gov.ar/handle/11336/139238},
  urldate = {2022-07-04},
  abstract = {Hace unos quince años Emir Sader propuso el concepto de postneoliberalismo, asumiendo que la era neoliberal en América del Sur había llegado a su fin. Este, crítico del neoliberalismo, coincidía sin embargo con él respecto a la no-búsqueda de homogeneidad social. Quizás como resignación, el postneoliberalismo nunca se propuso la igualdad sino la inclusión, y la política social cumplió un rol muy importante. Esto refiere a objetivos económicos menos pretenciosos, pero a una apertura política mayor: si no tenemos que ser todos iguales, podemos permitir la diversidad. Desde 2015 estamos presenciando un giro conservador tanto en el mundo como en la región. En América del Sur se trata de una avanzada postpostneoliberal, que conjuga un ideario económico ortodoxo con una retórica tradicionalista que se opone a la diversidad. A partir de un análisis de la política social en las nuevas derechas sudamericanas intentamos acercarnos a las nuevas concepciones sobre la relación entre Estado y mercado, para así comprender mejor el significado de las nuevas derechas (postpostneoliberales) en la región.},
  langid = {spanish},
  annotation = {Accepted: 2021-08-30T18:50:06Z},
  file = {C\:\\Users\\josed\\Zotero\\storage\\W7EWEZBD\\Dvoskin y Bevegni - 2020 - El postpostneoliberalismo sudamericano una mirada.pdf;C\:\\Users\\josed\\Zotero\\storage\\7T2M53HC\\139238.html}
}

